<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MasterReminder | Dashboard Oficial</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        darkBg: '#121517',
                        cardBg: '#1A1D20',
                        cardHover: '#22262B',
                        brandRed: '#D9383A',
                        brandRedHover: '#B52E30',
                        mutedText: '#A0A5AC'
                    }
                }
            }
        }
    </script>
</head>

<!-- Script para autorefrescar el dashboard cada 10 segundos -->
    <script>
        // Opcional: Recarga automática cada 10 segundos para ver cambios en tiempo real
        setTimeout(() => {
            location.reload();
        }, 10000); // 10000 ms = 10 segundos
    </script>
    
<body class="bg-darkBg text-white font-sans min-h-screen flex flex-col selection:bg-brandRed selection:text-white">

    <!-- Navbar -->
    <nav class="bg-cardBg/80 backdrop-blur-md border-b border-gray-800/80 px-6 py-4 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brandRed to-brandRedHover flex items-center justify-center font-black text-white text-lg tracking-wider shadow-lg shadow-brandRed/20">
                MR
            </div>
            <div>
                <span class="text-lg font-bold tracking-tight block">MasterReminder</span>
                <span class="text-xs text-mutedText block -mt-1">Panel de Control V1.0</span>
            </div>
        </div>
        <div class="flex items-center space-x-4">
            <span class="hidden sm:inline-flex text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1.5 rounded-full font-medium items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Sistema Operativo
            </span>
            <a href="https://discord.com/oauth2/authorize?client_id=1530315651355381882&permissions=8&integration_type=0&scope=bot" target="_blank" class="bg-brandRed hover:bg-brandRedHover text-white text-sm font-semibold px-4 py-2 rounded-xl transition-all shadow-lg shadow-brandRed/20 flex items-center gap-2">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                Invitar Bot
            </a>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-6 md:p-10 space-y-8">
        
        <!-- Banner de Bienvenida Innovador -->
        <div class="relative overflow-hidden bg-gradient-to-r from-cardBg to-[#221618] border border-gray-800/80 rounded-3xl p-8 shadow-2xl flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="space-y-2 z-10">
                <div class="inline-block bg-brandRed/15 text-brandRed border border-brandRed/30 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                    Asistente de Productividad
                </div>
                <h1 class="text-3xl md:text-4xl font-black tracking-tight">Bienvenido al Centro de Control</h1>
                <p class="text-mutedText max-w-xl text-sm md:text-base">
                    Gestiona recordatorios personalizados, monitorea conexiones en vivo con MongoDB Atlas y administra tus canales de texto con precisión milimétrica.
                </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 z-10 w-full md:w-auto">
                <a href="https://discord.com/oauth2/authorize?client_id=1530315651355381882&permissions=8&integration_type=0&scope=bot" target="_blank" class="bg-brandRed hover:bg-brandRedHover text-white font-bold px-6 py-3 rounded-xl transition-all shadow-lg shadow-brandRed/25 text-center flex items-center justify-center gap-2">
                    🚀 Invitar a tu Servidor
                </a>

            </div>
            <!-- Elemento de diseño de fondo -->
            <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-brandRed/10 rounded-full blur-3xl pointer-events-none"></div>
        </div>

        <!-- Tarjetas de Estadísticas en Vivo -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-cardBg border border-gray-800/80 rounded-2xl p-6 shadow-xl hover:border-gray-700 transition-all">
                <div class="flex justify-between items-start">
                    <p class="text-mutedText text-sm font-medium">Servidores Conectados</p>
                    <span class="p-2 bg-darkBg rounded-lg text-brandRed">🌐</span>
                </div>
                <p class="text-4xl font-black mt-4 text-white"><%= serversCount %></p>
                <p class="text-xs text-emerald-400 mt-2 font-medium">↑ Sincronizado globalmente</p>
            </div>
            
            <div class="bg-cardBg border border-gray-800/80 rounded-2xl p-6 shadow-xl hover:border-gray-700 transition-all">
                <div class="flex justify-between items-start">
                    <p class="text-mutedText text-sm font-medium">Recordatorios en Base de Datos</p>
                    <span class="p-2 bg-darkBg rounded-lg text-brandRed">⏰</span>
                </div>
                <p class="text-4xl font-black mt-4 text-white"><%= totalRecordatorios %></p>
                <p class="text-xs text-mutedText mt-2 font-medium">Almacenados de forma segura</p>
            </div>

            <div class="bg-cardBg border border-gray-800/80 rounded-2xl p-6 shadow-xl hover:border-gray-700 transition-all">
                <div class="flex justify-between items-start">
                    <p class="text-mutedText text-sm font-medium">Base de Datos MongoDB Atlas</p>
                    <span class="p-2 bg-darkBg rounded-lg text-brandRed">🍃</span>
                </div>
                <% if (dbStatus) { %>
                    <p class="text-2xl font-bold mt-4 text-emerald-400 flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span> En Línea
                    </p>
                    <p class="text-xs text-mutedText mt-2">Latencia estable (&lt; 45ms)</p>
                <% } else { %>
                    <p class="text-2xl font-bold mt-4 text-rose-500 flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-rose-500"></span> Sin Conexión
                    </p>
                    <p class="text-xs text-mutedText mt-2">Verifica tu URI en config.json</p>
                <% } %>
            </div>
        </div>

        <!-- Sección de Comandos Interactivos -->
        <div id="comandos" class="bg-cardBg border border-gray-800/80 rounded-3xl p-8 shadow-xl space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-extrabold">Catálogo de Comandos Slash</h2>
                    <p class="text-mutedText text-sm mt-1">Implementados y listos para usarse dentro de cualquier canal de Discord.</p>
                </div>
                <span class="bg-darkBg border border-gray-800 px-3 py-1 rounded-lg text-xs font-mono text-brandRed">Prefix: /</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Comando 1 -->
                <div class="bg-darkBg/60 border border-gray-800/80 p-5 rounded-2xl hover:border-brandRed/40 transition-all">
                    <div class="flex items-center justify-between mb-2">
                        <code class="text-brandRed font-bold text-base bg-brandRed/10 px-2.5 py-1 rounded-lg">/recordar</code>
                        <span class="text-xs bg-gray-800 text-mutedText px-2.5 py-1 rounded-md">Recordatorios</span>
                    </div>
                    <p class="text-sm text-mutedText">Programa alertas inteligentes especificando el mensaje, el tiempo (ej. 10m, 1h) y un canal de destino opcional.</p>
                </div>

                <!-- Comando 2 -->
                <div class="bg-darkBg/60 border border-gray-800/80 p-5 rounded-2xl hover:border-brandRed/40 transition-all">
                    <div class="flex items-center justify-between mb-2">
                        <code class="text-brandRed font-bold text-base bg-brandRed/10 px-2.5 py-1 rounded-lg">/help</code>
                        <span class="text-xs bg-gray-800 text-mutedText px-2.5 py-1 rounded-md">Utilidad</span>
                    </div>
                    <p class="text-sm text-mutedText">Despliega un panel de ayuda interactivo categorizado con toda la información y guías de uso del bot.</p>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-cardBg border-t border-gray-800/80 text-center py-6 px-6 mt-12 flex flex-col sm:flex-row justify-between items-center max-w-7xl mx-auto w-full text-xs text-mutedText gap-4">
        <p>© 2026 MasterReminder • Todos los derechos reservados.</p>
        <div class="flex space-x-6">
            <a href="#" class="hover:text-brandRed transition-colors">Términos de Servicio</a>
            <a href="#" class="hover:text-brandRed transition-colors">Política de Privacidad</a>
            <a href="#" class="hover:text-brandRed transition-colors">Soporte</a>
        </div>
    </footer>

</body>
</html>